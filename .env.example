# LLM Provider — pick one
# Option A: Anthropic (default)
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_SMALL_MODEL=claude-haiku-4-5-20251001

# Option B: OpenAI API
# OPENAI_API_KEY=sk-xxxxx
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_SMALL_MODEL=gpt-4o-mini

# Option C: ChatGPT subscription (no API key needed)
# Run `python -m agent.codex_auth` once to log in via browser
# LLM_PROVIDER=openai-codex
# LLM_MODEL=gpt-5.4
# LLM_SMALL_MODEL=gpt-5.4-mini

# Web search (Brave Search API — https://brave.com/search/api/)
# BRAVE_API_KEY=BSA-xxxxx

# Optional — Langfuse observability (remove if not using)
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# Gmail (App Password — https://myaccount.google.com/apppasswords)
# GMAIL_ADDRESS=your@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Telegram bot (only needed if running bot.py)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_OWNER_ID=your-telegram-user-id
